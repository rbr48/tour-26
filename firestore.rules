rules_version = '2';

// Data model (see src/services/tourStore.js):
//   tours/coxsbazar2026                  trip details, meeting point, schema marker
//   tours/coxsbazar2026/itinerary/*      day plan items
//   tours/coxsbazar2026/members/*        family members and deposits
//   tours/coxsbazar2026/expenses/*       spending entries
//   tours/coxsbazar2026/checklist/*      packing checklist
//   tours/coxsbazar2026/notices/*        notice board
//   tours/coxsbazar2026/posts/*          photo posts (thumbnail + Drive link)
//   tours/coxsbazar2026/channels/{id}/messages/*   chat
//   tours/coxsbazar2026/locations/{email}          live location, one per person
//   tours/coxsbazar2026/profiles/{email}           personal profile, one per person
//   tours/coxsbazar2026/meta/migration             upgrade lock and status (admins only)
//   config/access                                  admin list (read by signed-in accounts)
//
// Who may do what:
// - Any Google account with a verified email can read the trip. It can write only what it
//   owns: its own expenses, posts, chat messages, location and profile. Any signed-in
//   account can add or remove checklist items, and tick itinerary items (the `done` field
//   only).
// - Admins (the emails in config/access.admins) change the trip details, the itinerary,
//   the roster and deposits, and the notice board, and they can delete other people's
//   records. These drive the safety screen and the money, so they are not open to every
//   account.
// - Records imported from the old single-document layout carry `migrated: true` and can
//   only be written by an admin, so they keep their original authorship.
//
// Firestore applies read rules to each document a listener touches. The app listens to
// whole collections for locations and profiles, so any signed-in account can read those.
//
// The admin list is set in the Firebase console, never from the app:
//   config/access = { admins: ["a@example.com", ...] }

service cloud.firestore {
  match /databases/{database}/documents {

    function access() {
      return get(/databases/$(database)/documents/config/access).data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email in access().admins;
    }

    function myEmail() {
      return request.auth.token.email;
    }

    function fits(maxFields) {
      return request.resource.data.keys().size() <= maxFields;
    }

    // Optional text fields must stay within a size bound. Large images are not
    // allowed in Firestore documents; full-size photos live in Google Drive.
    function textWithin(field, maxLength) {
      return !(field in request.resource.data)
        || (request.resource.data[field] is string && request.resource.data[field].size() <= maxLength);
    }

    // Money and deposits must be plain numbers inside the trip's range (1 Crore taka).
    function isPositiveBoundedNumber(field, maxNum) {
      return !(field in request.resource.data)
        || (request.resource.data[field] is number && request.resource.data[field] >= 0 && request.resource.data[field] <= maxNum);
    }

    function onlyChanged(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // The admin list. Signed-in accounts can read it so the app can show admin-only
    // controls. Nobody can change it from the app.
    match /config/{docId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /tours/{tourId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin()
        && request.resource.data.updatedBy.uid == request.auth.uid
        && fits(20);
      allow delete: if false;

      match /itinerary/{itemId} {
        allow read: if isSignedIn();
        allow create: if isAdmin() && fits(25) && textWithin('notes', 2000);
        allow update: if (isAdmin() && fits(25) && textWithin('notes', 2000))
          || (isSignedIn() && onlyChanged(['done']));
        allow delete: if isAdmin();
      }

      match /members/{memberId} {
        allow read: if isSignedIn();
        allow create, update: if isAdmin() && fits(25) && isPositiveBoundedNumber('deposit', 10000000);
        allow delete: if isAdmin();
      }

      match /expenses/{expenseId} {
        allow read: if isSignedIn();
        allow create: if ((isSignedIn() && request.resource.data.addedByEmail == myEmail())
            || (isAdmin() && request.resource.data.migrated == true))
          && fits(25)
          && isPositiveBoundedNumber('amount', 10000000)
          && textWithin('title', 300);
        allow update: if ((isSignedIn() && resource.data.addedByEmail == myEmail()) || isAdmin())
          && request.resource.data.addedByEmail == resource.data.addedByEmail
          && fits(25)
          && isPositiveBoundedNumber('amount', 10000000)
          && textWithin('title', 300);
        allow delete: if isSignedIn()
          && (resource.data.addedByEmail == myEmail() || isAdmin());
      }

      match /checklist/{itemId} {
        allow read: if isSignedIn();
        allow create, update: if isSignedIn() && fits(15) && textWithin('item', 500);
        allow delete: if isSignedIn();
      }

      match /notices/{noticeId} {
        allow read: if isSignedIn();
        allow create, update: if isAdmin() && fits(20) && textWithin('content', 4000);
        allow delete: if isAdmin();
      }

      match /posts/{postId} {
        allow read: if isSignedIn();
        allow create: if ((isSignedIn() && request.resource.data.authorEmail == myEmail())
            || (isAdmin() && request.resource.data.migrated == true))
          && fits(35)
          && textWithin('thumb', 150000)
          && textWithin('caption', 1000)
          && textWithin('image', 600000);
        allow update: if isSignedIn()
          && request.resource.data.authorEmail == resource.data.authorEmail
          && fits(35)
          && textWithin('thumb', 150000)
          && textWithin('caption', 1000)
          && (resource.data.authorEmail == myEmail() || onlyChanged(['likes', 'comments', 'views']));
        allow delete: if isSignedIn()
          && (resource.data.authorEmail == myEmail() || isAdmin());
      }

      match /channels/{channelId}/messages/{messageId} {
        allow read: if isSignedIn() && channelId in ['general', 'food', 'sightseeing', 'emergency', 'plans'];
        allow create: if channelId in ['general', 'food', 'sightseeing', 'emergency', 'plans']
          && ((isSignedIn() && request.resource.data.senderEmail == myEmail())
              || (isAdmin() && request.resource.data.migrated == true))
          && fits(20)
          && textWithin('text', 4000);
        allow update: if isSignedIn()
          && channelId in ['general', 'food', 'sightseeing', 'emergency', 'plans']
          && request.resource.data.senderEmail == resource.data.senderEmail
          && (resource.data.senderEmail == myEmail() || onlyChanged(['reactions']));
        allow delete: if isSignedIn()
          && (resource.data.senderEmail == myEmail() || isAdmin());
      }

      match /locations/{email} {
        allow read: if isSignedIn();
        allow create, update: if isSignedIn() && email == myEmail() && fits(20);
        allow delete: if isSignedIn() && (email == myEmail() || isAdmin());
      }

      // Game rooms, their index and typing status are shared state that any signed-in
      // account writes. Everything else under meta (the migration lock) stays admin-only.
      match /meta/{docId} {
        allow read: if isSignedIn();
        allow write: if isAdmin()
          || (isSignedIn() && (docId == 'gamerooms_list'
            || docId.matches('gameroom_.*')
            || docId.matches('typing_.*')));
      }

      match /profiles/{email} {
        allow read: if isSignedIn();
        allow create, update: if isSignedIn()
          && (email == myEmail() || isAdmin())
          && fits(25)
          && textWithin('customPhotoURL', 150000);
        allow delete: if isAdmin();
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
