rules_version = '2';

// Tour 2026 Firestore Security Rules
// Protects database from unauthenticated access, enforces field constraints,
// and restricts administrative management (expenses, members, itinerary, checklist, notices)
// strictly to the admin (rajbrur@gmail.com and config/access admins).
// General users can read tour data and only create/update/delete their own
// feed posts, reactions, comments, profile, and chat messages.

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email.lower() == 'rajbrur@gmail.com' ||
        (exists(/databases/$(database)/documents/config/access) &&
         request.auth.token.email.lower() in get(/databases/$(database)/documents/config/access).data.admins)
      );
    }

    function fits(maxFields) {
      return request.resource.data.keys().size() <= maxFields;
    }

    function textWithin(field, maxLength) {
      return !(field in request.resource.data)
        || request.resource.data[field] == null
        || (request.resource.data[field] is string && request.resource.data[field].size() <= maxLength);
    }

    function isPositiveBoundedNumber(field, maxNum) {
      return !(field in request.resource.data)
        || (request.resource.data[field] is number && request.resource.data[field] >= 0 && request.resource.data[field] <= maxNum);
    }

    // Config access document (if present)
    match /config/{docId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /tours/{tourId} {
      allow read: if isAuthenticated();
      // Allow updates to tour info from admin only, reject legacy array injection
      allow create, update: if isAdmin()
        && fits(20)
        && !('expenses' in request.resource.data)
        && !('discussions' in request.resource.data)
        && !('userProfiles' in request.resource.data);
      allow delete: if false;

      match /itinerary/{itemId} {
        allow read: if isAuthenticated();
        allow create, update: if isAdmin() && fits(25) && textWithin('notes', 2000);
        allow delete: if isAdmin();
      }

      match /members/{memberId} {
        allow read: if isAuthenticated();
        allow create, update: if isAdmin()
          && fits(25)
          && isPositiveBoundedNumber('deposit', 10000000);
        allow delete: if isAdmin();
      }

      match /expenses/{expenseId} {
        allow read: if isAuthenticated();
        allow create: if isAdmin()
          && fits(25)
          && isPositiveBoundedNumber('amount', 10000000)
          && textWithin('title', 300);
        allow update: if isAdmin()
          && fits(25)
          && isPositiveBoundedNumber('amount', 10000000)
          && textWithin('title', 300);
        allow delete: if isAdmin();
      }

      match /checklist/{itemId} {
        allow read: if isAuthenticated();
        allow create, update: if isAdmin() && fits(15) && textWithin('text', 500);
        allow delete: if isAdmin();
      }

      match /notices/{noticeId} {
        allow read: if isAuthenticated();
        allow create, update: if isAdmin() && fits(20) && textWithin('content', 4000);
        allow delete: if isAdmin();
      }

      match /posts/{postId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated()
          && fits(35)
          && textWithin('thumb', 350000)
          && textWithin('caption', 1000);
        allow update: if isAuthenticated()
          && fits(35)
          && textWithin('thumb', 350000)
          && (
            isAdmin() ||
            resource.data.authorEmail == null ||
            resource.data.authorEmail.lower() == 'member@tour.family' ||
            (resource.data.authorEmail != null && request.auth.token.email.lower() == resource.data.authorEmail.lower()) ||
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'comments', 'views', 'driveBackedUp', 'driveFileId', 'driveViewUrl', 'driveDownloadUrl', 'driveFileIds', 'driveViewUrls', 'thumbs'])
          );
        allow delete: if isAuthenticated()
          && (
            isAdmin() ||
            resource.data.authorEmail == null ||
            resource.data.authorEmail.lower() == 'member@tour.family' ||
            (resource.data.authorEmail != null && request.auth.token.email.lower() == resource.data.authorEmail.lower())
          );
      }

      match /channels/{channelId}/messages/{messageId} {
        allow read: if isAuthenticated() && channelId in ['general', 'food', 'sightseeing', 'emergency', 'plans'];
        allow create: if isAuthenticated()
          && channelId in ['general', 'food', 'sightseeing', 'emergency', 'plans']
          && fits(20)
          && textWithin('text', 4000);
        allow update: if isAuthenticated()
          && channelId in ['general', 'food', 'sightseeing', 'emergency', 'plans']
          && fits(20)
          && (
            isAdmin() ||
            (resource.data.senderEmail != null && request.auth.token.email.lower() == resource.data.senderEmail.lower()) ||
            (resource.data.authorEmail != null && request.auth.token.email.lower() == resource.data.authorEmail.lower()) ||
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
          );
        allow delete: if isAuthenticated()
          && (
            isAdmin() ||
            (resource.data.senderEmail != null && request.auth.token.email.lower() == resource.data.senderEmail.lower()) ||
            (resource.data.authorEmail != null && request.auth.token.email.lower() == resource.data.authorEmail.lower())
          );
      }

      match /locations/{email} {
        allow read: if isAuthenticated();
        allow create, update: if isAuthenticated()
          && (isAdmin() || request.auth.token.email.lower() == email.lower())
          && fits(20);
        allow delete: if isAuthenticated()
          && (isAdmin() || request.auth.token.email.lower() == email.lower());
      }

      match /meta/{docId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated();
      }

      match /profiles/{email} {
        allow read: if isAuthenticated();
        allow create, update: if isAuthenticated()
          && (isAdmin() || request.auth.token.email.lower() == email.lower())
          && fits(25)
          && textWithin('customPhotoURL', 200000);
        allow delete: if isAuthenticated()
          && (isAdmin() || request.auth.token.email.lower() == email.lower());
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
